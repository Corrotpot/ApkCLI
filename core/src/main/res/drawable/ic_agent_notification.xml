<!--
  Notification icon.

  Must be a single-colour silhouette: the system tints it and discards colour
  information, so anything else shows up as a white blob. A terminal prompt
  glyph, since that is what the agent is doing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Window frame -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M3,3h18a1,1 0 0 1 1,1v16a1,1 0 0 1 -1,1H3a1,1 0 0 1 -1,-1V4a1,1 0 0 1 1,-1zM4,7v12h16V7H4z" />

    <!-- Prompt chevron -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M6.7,10.3l1.4,-1.4l3.6,3.6l-3.6,3.6l-1.4,-1.4l2.2,-2.2z" />

    <!-- Cursor underscore -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12.5,15h5v1.8h-5z" />
</vector>
