{
  "$comment": [
    "ApkCLI design tokens, black theme: the single source of the design prototype",
    "(tools/gen_design.py turns them into CSS) and of the Compose theme when the",
    "design moves into the app. Units: sizes and radii in dp (CSS px in the",
    "prototype), text in sp at font scale 1.0. Colours are #RRGGBB or #RRGGBBAA",
    "(alpha last, as in CSS; Compose wants 0xAARRGGBB).",
    "Text is laid out as CSS does it: line height centred on the glyphs, no font",
    "padding. In Compose: LineHeightStyle(Alignment.Center, Trim.None) and",
    "PlatformTextStyle(includeFontPadding = false). Font features below apply in",
    "both; optical sizing stays off (Inter's default opsz), as Android has none."
  ],

  "color": {
    "bg": "#000000",
    "surface1": "#0D0D0F",
    "surface2": "#141417",
    "surface3": "#1C1C21",
    "border": "#1F1F24",
    "borderStrong": "#2C2C33",
    "borderFocus": "#3F3F48",
    "divider": "#17171B",
    "pressed": "#FFFFFF0F",
    "handle": "#3A3A42",
    "scrim": "#000000B3",

    "text": "#F2F2F3",
    "textBody": "#E4E4E7",
    "textSecondary": "#A1A1AA",
    "textTertiary": "#7C7C85",
    "textDisabled": "#4A4A52",

    "accent": "#7FD1AE",
    "accentMuted": "#7FD1AE1F",
    "onAccent": "#03130C",
    "primary": "#F2F2F3",
    "primaryPressed": "#D4D4D8",
    "onPrimary": "#000000",

    "success": "#7FD1AE",
    "warning": "#E3B341",
    "warningMuted": "#E3B3411F",
    "error": "#FF7B72",
    "errorMuted": "#FF7B721F",
    "info": "#79C0FF",

    "diffAddFg": "#7FD1AE",
    "diffAddBg": "#7FD1AE17",
    "diffRemoveFg": "#FF7B72",
    "diffRemoveBg": "#FF7B7217",

    "codeBg": "#0A0A0C",
    "currentLine": "#0E0E11",
    "terminalBg": "#000000"
  },

  "syntax": {
    "$comment": "VS Code Dark Modern's token colours, on black.",
    "plain": "#D4D4D4",
    "keyword": "#569CD6",
    "control": "#C586C0",
    "string": "#CE9178",
    "number": "#B5CEA8",
    "comment": "#6A9955",
    "function": "#DCDCAA",
    "type": "#4EC9B0",
    "variable": "#9CDCFE",
    "constant": "#4FC1FF"
  },

  "ansi": {
    "$comment": "VS Code's integrated terminal palette.",
    "foreground": "#CCCCCC",
    "black": "#000000",
    "red": "#CD3131",
    "green": "#0DBC79",
    "yellow": "#E5E510",
    "blue": "#2472C8",
    "magenta": "#BC3FBC",
    "cyan": "#11A8CD",
    "white": "#E5E5E5",
    "brightBlack": "#666666",
    "brightRed": "#F14C4C",
    "brightGreen": "#23D18B",
    "brightYellow": "#F5F543",
    "brightBlue": "#3B8EEA",
    "brightMagenta": "#D670D6",
    "brightCyan": "#29B8DB",
    "brightWhite": "#E5E5E5"
  },

  "avatar": {
    "$comment": "Project tiles: the letter in hues[i], on hues[i] at 14% alpha, where i is the sum of the UTF-16 code units of the lower-cased name, mod 8.",
    "alpha": "24",
    "hues": ["#7FD1AE", "#79C0FF", "#D2A8FF", "#FFA657", "#FF7B72", "#E3B341", "#56D4DD", "#F778BA"]
  },

  "font": {
    "sans": { "family": "Inter", "features": "" },
    "mono": { "family": "JetBrains Mono", "features": "\"liga\" 0, \"calt\" 0" },
    "setiScale": 1.22
  },

  "text": {
    "title":       { "font": "sans", "size": 28, "line": 34, "weight": 600, "tracking": -0.5 },
    "headline":    { "font": "sans", "size": 17, "line": 22, "weight": 600, "tracking": -0.2 },
    "bodyLarge":   { "font": "sans", "size": 16, "line": 22, "weight": 400 },
    "body":        { "font": "sans", "size": 15, "line": 22, "weight": 400 },
    "bodyMedium":  { "font": "sans", "size": 14, "line": 20, "weight": 400 },
    "bodySmall":   { "font": "sans", "size": 13, "line": 18, "weight": 400 },
    "label":       { "font": "sans", "size": 15, "line": 20, "weight": 500 },
    "labelMedium": { "font": "sans", "size": 14, "line": 18, "weight": 500 },
    "labelSmall":  { "font": "sans", "size": 13, "line": 16, "weight": 500 },
    "labelTiny":   { "font": "sans", "size": 12, "line": 16, "weight": 500 },
    "caption":     { "font": "sans", "size": 12, "line": 16, "weight": 400 },
    "nav":         { "font": "sans", "size": 12, "line": 16, "weight": 500 },
    "overline":    { "font": "sans", "size": 11, "line": 14, "weight": 600, "tracking": 0.8, "uppercase": true },
    "code":        { "font": "mono", "size": 13, "line": 20, "weight": 400 },
    "codeSmall":   { "font": "mono", "size": 12, "line": 18, "weight": 400 },
    "monoCaption": { "font": "mono", "size": 12, "line": 16, "weight": 400 },
    "monoLabel":   { "font": "mono", "size": 13, "line": 16, "weight": 500 },
    "avatar":      { "font": "sans", "size": 16, "line": 20, "weight": 600 }
  },

  "radius": {
    "card": 14,
    "button": 12,
    "input": 12,
    "tile": 10,
    "toolCard": 12,
    "codeBlock": 12,
    "box": 8,
    "inlineCode": 6,
    "bubble": 18,
    "bubbleTail": 6,
    "composer": 20,
    "sheet": 20,
    "menu": 12,
    "menuItem": 8,
    "segment": 10,
    "segmentInner": 7,
    "session": 10,
    "key": 8,
    "pill": 999
  },

  "size": {
    "statusBar": 28,
    "gestureBar": 20,
    "topBar": 56,
    "bottomNav": 64,
    "iconButton": 48,
    "iconButtonSmall": 40,
    "iconButtonComposer": 36,
    "icon": 20,
    "iconSmall": 16,
    "iconTiny": 14,
    "row": 64,
    "rowCompact": 52,
    "treeRow": 40,
    "tile": 40,
    "logoTile": 48,
    "input": 48,
    "button": 48,
    "buttonSmall": 36,
    "chip": 30,
    "session": 32,
    "key": 30,
    "tab": 40,
    "send": 36,
    "ring": 20,
    "navPillWidth": 56,
    "navPillHeight": 30,
    "sheetHandleWidth": 36,
    "sheetHandleHeight": 4,
    "spinner": 14,
    "statusLine": 24
  },

  "motion": {
    "$comment": "Durations in ms; easings as cubic-bezier control points.",
    "press": 90,
    "screen": 220,
    "sheetIn": 280,
    "sheetOut": 200,
    "expand": 200,
    "menu": 120,
    "toast": 200,
    "spinner": 800,
    "standard": [0.2, 0.0, 0.0, 1.0],
    "decelerate": [0.05, 0.7, 0.1, 1.0],
    "accelerate": [0.3, 0.0, 0.8, 0.15]
  }
}
